<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Fixed synthetic sources, present exclusively in the instrumentation APK. -->
        <provider android:name="app.sourcescribe.data.AudioImportFixtureProvider"
            android:authorities="app.sourcescribe.audio-import-fixture"
            android:exported="true" />
        <provider android:name="app.sourcescribe.data.ExportFixtureProvider"
            android:authorities="app.sourcescribe.test.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider android:name="app.sourcescribe.data.ExportFixtureProvider$ControlProvider"
            android:authorities="app.sourcescribe.test.documents.control"
            android:exported="true"
            android:permission="android.permission.ACCESS_CONTENT_PROVIDERS_EXTERNALLY" />
    </application>
</manifest>
